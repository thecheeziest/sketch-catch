{
  "name": "sketch-catch",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "pnpm --filter @sketch-catch/server run dev",
    "ios:dev": "pnpm --filter @sketch-catch/mobile run ios:dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0"
  },
  "pnpm": {
    "packageExtensions": {
      "@invertase/react-native-apple-authentication": {
        "dependencies": {
          "prop-types": "^15.8.1"
        }
      }
    },
    "patchedDependencies": {
      "dripsy@4.3.8": "patches/dripsy@4.3.8.patch"
    }
  }
}

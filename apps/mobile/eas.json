{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://server-production-166c.up.railway.app",
        "EXPO_PUBLIC_SOCKET_URL": "https://server-production-166c.up.railway.app"
      },
      "ios": {
        "distribution": "store"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "test",
      "environment": "preview"
    }
  }
}

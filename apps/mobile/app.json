{
  "expo": {
    "name": "SketchCatch",
    "slug": "sketch-catch",
    "scheme": "sketchcatch",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF0"
    },
    "ios": {
      "icon": "./assets/icon-ios.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.sketchcatch.app",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.sketchcatch.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "4ac106e05b38f8ae3856df1ffe534420",
          "kotlinVersion": "1.9.0"
        }
      ],
      [
        "expo-media-library",
        { "photosPermission": "그림 GIF를 저장하려면 사진 접근 권한이 필요합니다." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "developmentClient": {
      "silentLaunch": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f6970800-ce5d-414d-880e-dc6bbda29d67"
      }
    },
    "owner": "zoazoa"
  }
}

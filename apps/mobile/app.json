{
  "expo": {
    "name": "SketchCatch",
    "slug": "sketch-catch",
    "scheme": "sketchcatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icons/04-shooting-star-symbol.png",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/app-icons/04-shooting-star-symbol.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.sketchcatch.ios",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      },
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "67ZA24MTS6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icons/symbol-adaptive-foreground.png",
        "backgroundColor": "#1E1C2C"
      },
      "package": "com.sketchcatch.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/app-icons/04-shooting-star-symbol.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "4ac106e05b38f8ae3856df1ffe534420",
          "kotlinVersion": "2.1.20"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "그림 GIF를 저장하려면 사진 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-splash-v2.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E1C2C",
          "imageWidth": 280,
          "ios": {
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      [
        "./plugins/withAppDisplayName.cjs",
        {
          "displayName": "스케치캐치",
          "alternateNames": ["SketchCatch", "Sketch Catch"]
        }
      ],
      [
        "./plugins/withStoreIcon.cjs",
        {
          "storeIcon": "./assets/app-icons/01-deep-space.png"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/withSceneLifecycle.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "developmentClient": {
      "silentLaunch": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f6970800-ce5d-414d-880e-dc6bbda29d67"
      }
    },
    "owner": "zoazoa",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f6970800-ce5d-414d-880e-dc6bbda29d67",
      "enabled": true
    }
  }
}

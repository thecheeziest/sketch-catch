# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database (로컬: docker-compose, 프로덕션: Railway)
DATABASE_URL=postgresql://sketch:sketch@localhost:5432/sketchcatch?schema=public

# Redis (로컬: docker-compose, 프로덕션: Railway)
REDIS_URL=redis://localhost:6379

# 인증 (Phase 2에서 사용)
KAKAO_REST_KEY=your-kakao-rest-api-key
APPLE_BUNDLE_ID=com.sketchcatch.app
JWT_SECRET=replace-with-strong-random-32-bytes-or-more

# 푸시 (Phase 7에서 사용, 옵션)
EXPO_ACCESS_TOKEN=

# 개발 전용 테스트 로그인 (POST /auth/dev) — production에서는 무시됨
ENABLE_DEV_LOGIN=false

# 강제 업데이트 — 플랫폼별 최소 빌드 번호(iOS CFBundleVersion / Android versionCode). 비우면 차단 안 함
MIN_BUILD_IOS=
MIN_BUILD_ANDROID=
# 업데이트 링크 — 출시 전: TestFlight 공개 링크·Play 내부 테스트 링크 / 출시 후: 스토어 링크
APP_UPDATE_URL_IOS=
APP_UPDATE_URL_ANDROID=

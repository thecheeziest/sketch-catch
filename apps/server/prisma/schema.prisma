generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  provider          Provider
  providerId        String
  nickname          String
  characterId       String
  friendCode        String
  pushToken         String?
  createdAt         DateTime  @default(now())
  nicknameChangedAt DateTime?
  coins             Int       @default(0)
  // 장착한 꾸미기 — null은 기본 모습. 값은 packages/shared SHOP_ITEMS id
  frameId           String?
  backgroundId      String?
  chatColorId       String?

  friendsA        Friendship[]    @relation("FriendshipA")
  friendsB        Friendship[]    @relation("FriendshipB")
  sentRequests    FriendRequest[] @relation("Sender")
  recvRequests    FriendRequest[] @relation("Receiver")
  items           UserItem[]
  coinLedger      CoinLedger[]
  appleIdentities AppleIdentity[]

  @@unique([provider, providerId])
  @@unique([nickname, friendCode])
}

// 배포 팀이 바뀌어도 동일한 사용자·게임 데이터를 유지하기 위한 Apple 로그인 식별자.
model AppleIdentity {
  providerId String   @id
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 보유 아이템 (캐릭터 포함) — 카탈로그는 packages/shared SHOP_ITEMS
model UserItem {
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

// 코인 원장 — refId(gameId·itemId)와 사유가 같은 행은 한 번만 생겨 중복 지급·차감을 막는다
model CoinLedger {
  id        String     @id @default(uuid())
  userId    String
  amount    Int // 지급 +, 차감 -
  reason    CoinReason
  refId     String
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
}

enum CoinReason {
  GAME
  FIRST_GAME_BONUS
  WELCOME
  PURCHASE
}

enum Provider {
  KAKAO
  APPLE
}

model FriendRequest {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  status     ReqStatus @default(PENDING)
  createdAt  DateTime  @default(now())

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

enum ReqStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipA", fields: [userAId], references: [id])
  userB User @relation("FriendshipB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

model GameReplay {
  id             String   @id @default(uuid())
  roomCode       String
  sheetId        String // = 시트 원조자 userId (원조자 식별)
  ownerId        String // 시트 원조자
  participantIds String[] // GIF-02: 저장 요청 권한자 = 시트 스텝 참여자 전원
  steps          Json // Mode2StepContent[] — 텍스트(PROMPT/ANSWER)+스트로크(DRAW) 혼합 (D-14)
  gifUrl         String? // 생성된 GIF 접근 키/경로
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([sheetId])
  @@index([expiresAt])
}

model WordPool {
  id        String   @id @default(uuid())
  word      String   @unique
  category  Category
  length    Int
  createdAt DateTime @default(now())

  @@index([category, length])
}

enum Category {
  ANIMAL
  FOOD
  OBJECT
  NATURE
  PLACE
  ACTION
  JOB
  PROVERB
  IDIOM
  MOVIE
  DRAMA
  MEME
  CUSTOM
}

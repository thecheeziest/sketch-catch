generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  provider          Provider
  providerId        String
  nickname          String
  characterId       String
  friendCode        String
  pushToken         String?
  createdAt         DateTime  @default(now())
  nicknameChangedAt DateTime?
  coins             Int       @default(0)
  // 장착한 꾸미기 — null은 기본 모습. 값은 packages/shared SHOP_ITEMS id
  frameId           String?
  backgroundId      String?
  chatColorId       String?
  // 프로필에 보이는 한마디 — null은 미설정
  statusMessage     String?

  friendsA        Friendship[]    @relation("FriendshipA")
  friendsB        Friendship[]    @relation("FriendshipB")
  sentRequests    FriendRequest[] @relation("Sender")
  recvRequests    FriendRequest[] @relation("Receiver")
  items           UserItem[]
  coinLedger      CoinLedger[]
  appleIdentities AppleIdentity[]
  blocking        UserBlock[]     @relation("Blocker")
  blockedBy       UserBlock[]     @relation("Blocked")
  reportsSent     UserReport[]    @relation("Reporter")
  reportsReceived UserReport[]    @relation("ReportTarget")

  @@unique([provider, providerId])
  @@unique([nickname, friendCode])
}

// 배포 팀이 바뀌어도 동일한 사용자·게임 데이터를 유지하기 위한 Apple 로그인 식별자.
model AppleIdentity {
  providerId String   @id
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 보유 아이템 (캐릭터 포함) — 카탈로그는 packages/shared SHOP_ITEMS
model UserItem {
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

// 코인 원장 — refId(gameId·itemId)와 사유가 같은 행은 한 번만 생겨 중복 지급·차감을 막는다
model CoinLedger {
  id        String     @id @default(uuid())
  userId    String
  amount    Int // 지급 +, 차감 -
  reason    CoinReason
  refId     String
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
}

enum CoinReason {
  GAME
  FIRST_GAME_BONUS
  WELCOME
  PURCHASE
}

enum Provider {
  KAKAO
  APPLE
}

model FriendRequest {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  status     ReqStatus @default(PENDING)
  createdAt  DateTime  @default(now())

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

enum ReqStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipA", fields: [userAId], references: [id])
  userB User @relation("FriendshipB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

// 차단 — 차단한 사람에게 상대 채팅을 가리고, 서로 친구 요청·초대를 막는다
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum ReportReason {
  ABUSE
  SEXUAL
  SPAM
  OTHER
}

// 신고 — 운영자가 DB에서 확인한다. 채팅 신고는 서버가 보관한 원문을 함께 남긴다 (클라이언트가 보낸 원문은 믿지 않는다)
model UserReport {
  id          String       @id @default(uuid())
  reporterId  String
  targetId    String
  reason      ReportReason
  // 사유가 '기타'일 때 신고자가 직접 쓴 내용
  detail      String?
  messageId   String?
  messageText String?
  roomCode    String?
  createdAt   DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, createdAt])
  @@index([reporterId, targetId])
}

model GameReplay {
  id             String   @id @default(uuid())
  roomCode       String
  sheetId        String // = 시트 원조자 userId (원조자 식별)
  ownerId        String // 시트 원조자
  participantIds String[] // GIF-02: 저장 요청 권한자 = 시트 스텝 참여자 전원
  steps          Json // Mode2StepContent[] — 텍스트(PROMPT/ANSWER)+스트로크(DRAW) 혼합 (D-14)
  gifUrl         String? // 생성된 GIF 접근 키/경로
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([sheetId])
  @@index([expiresAt])
}

model WordPool {
  id        String   @id @default(uuid())
  word      String   @unique
  category  Category
  length    Int
  createdAt DateTime @default(now())

  @@index([category, length])
}

enum Category {
  ANIMAL
  FOOD
  OBJECT
  NATURE
  PLACE
  ACTION
  JOB
  PERSON
  MOVIE
  DRAMA
  VARIETY
  ANIMATION
  MEME
  CUSTOM
}
